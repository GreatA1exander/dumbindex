---
import Tier from "./Tier.astro";
import { ageDays } from "../lib/data.js";
const { rows, showDomain = true } = Astro.props;
const cls = (n) => (n == null ? "" : n > 180 ? "age rotten" : n > 60 ? "age stale" : "age");
---
{rows.length === 0 ? (
  <p class="empty">
    Nothing verified here yet. Records appear only after they clear the evidence bar
    — see <a href="/method/">Method</a>.
  </p>
) : (
  <div class="tablewrap">
  <table class={`devices grid ${showDomain ? "with-type" : "no-type"}`}>
    {/* Explicit widths, because a domain page stacks several of these tables and
        auto-layout would size each one to its own contents — so MODEL would start at a
        different x in every section and the page would read as ragged. */}
    <colgroup>
      <col class="c-make" />
      <col class="c-model" />
      {showDomain && <col class="c-type" />}
      <col class="c-tier" />
      <col class="c-acct" />
      <col class="c-ota" />
      <col class="c-price" />
      <col class="c-verified" />
    </colgroup>
    <thead>
      <tr>
        <th>Make</th>
        <th>Model</th>
        {showDomain && <th>Type</th>}
        <th>Tier</th>
        <th>Account</th>
        <th>Forced&nbsp;OTA</th>
        <th class="num">Price</th>
        <th class="num">Verified</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((d) => (
        <tr>
          <td class="make">{d.make}</td>
          <td>
            <a class="model" href={`/device/${d.model_id}/`}>{d.model}</a>
            {d.record_type === "family" && <span class="famtag">product line</span>}
            {d.availability === "discontinued" && <span class="age"> · discontinued</span>}
          </td>
          {showDomain && <td>{d.subcategory ?? d.category}</td>}
          <td><Tier tier={d.tier} /></td>
          <td>{d.account_required === "none" ? "none" : d.account_required?.replace(/_/g, " ")}</td>
          <td>{d.firmware_ota_forced === "no" ? "no" : d.firmware_ota_forced?.replace(/_/g, " ")}</td>
          <td class="num">{d.price_band ?? "—"}</td>
          <td class="num"><span class={cls(ageDays(d.last_verified))}>{d.last_verified ?? "—"}</span></td>
        </tr>
      ))}
    </tbody>
  </table>
  </div>
)}
