---
import Base from "../layouts/Base.astro";
import { changeFeed } from "../lib/data.js";
const { material, listings } = changeFeed();
---
<Base title="What changed" current="changed"
      description="Tier changes, vendor incidents, and devices that got worse after purchase.">
  <h1>What changed</h1>
  <p class="lede">
    A device's tier is a snapshot, not a property. Vendors revoke it after you have paid —
    a firmware update adds an account requirement, a server shuts down, a feature moves
    behind a subscription. Every published record is re-checked monthly and everything we
    find lands here.
  </p>
  <h2>Devices that changed</h2>
  {material.length === 0 ? (
    <p class="empty">
      Nothing yet. This is the good outcome — it means no device we list has lost
      function since we checked it. The monthly refresh fills this in when one does.
    </p>
  ) : (
    <div class="tablewrap">
    <table class="devices">
      <tbody>
        {material.map((c) => (
          <tr>
            <td class="num">{c.date}</td>
            <td><a href={c.device.status === "rejected" ? "/rejected/" : `/device/${c.device.model_id}/`}>{c.device.make} {c.device.model}</a></td>
            <td>{c.change}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  )}

  <h2>Newly listed</h2>
  <p class="age">Routine additions to the catalog. Kept separate so the section above stays worth reading.</p>
  <div class="tablewrap">
  <table class="devices">
    <tbody>
      {listings.map((c) => (
        <tr>
          <td class="num">{c.date}</td>
          <td><a href={c.device.status === "rejected" ? "/rejected/" : `/device/${c.device.model_id}/`}>{c.device.make} {c.device.model}</a></td>
          <td>{c.change}</td>
        </tr>
      ))}
    </tbody>
  </table>
  </div>
  </Base>
