---
import Base from "../../layouts/Base.astro";
import DeviceTable from "../../components/DeviceTable.astro";
import { domains, byDomain, populatedSubs, slugify } from "../../lib/data.js";

export function getStaticPaths() {
  return domains.map((d) => ({ params: { domain: d.slug }, props: { domain: d } }));
}
const { domain } = Astro.props;
const rows = byDomain(domain.slug);
const subs = populatedSubs(domain.slug);
---
<Base title={domain.name} current={domain.slug} description={domain.blurb}>
  <h1>{domain.name}</h1>
  <p class="lede">{domain.blurb}</p>
  {domain.problem && <p class="lede">{domain.problem}</p>}

  {subs.length > 0 && (
    <p class="filters">
      <span class="lbl">Jump to</span>
      {subs.map((s) => (
        <a href={`/${domain.slug}/${slugify(s.sub)}/`}>{s.sub} ({s.count})</a>
      ))}
    </p>
  )}

  <DeviceTable rows={rows} />
</Base>
